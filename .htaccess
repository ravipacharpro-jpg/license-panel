RewriteEngine On
RewriteBase /

# Security: Disable directory listing
Options -Indexes

# Security: Block access to hidden files (.env, .git, etc.)
RewriteRule ^\. - [F,L]

# Direct API bypass
RewriteRule ^api/connect/?$ api/connect.php [QSA,L]

# Ignore physical files/directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else through the router
RewriteRule ^(.*)$ index.php?uri=$1 [QSA,L]
