# Copy to .env and fill (Render -> Environment tab me bhi same keys daalo)
APP_URL=http://localhost:8000
DB_DRIVER=sqlite
SQLITE_PATH=/var/www/html/data/database.sqlite
# SQLITE_PATH=data/database.sqlite  (local php -S ke liye relative bhi chalega via absolute resolution)

# MySQL (optional - DB_DRIVER=mysql karne pe use hoga)
# DATABASE_URL=mysql://user:pass@host:3306/license_panel
DB_HOST=localhost
DB_PORT=3306
DB_NAME=license_panel
DB_USER=root
DB_PASS=

# Defaults (DB settings table me override ho jate hain)
REFERRAL_PERCENT=10
